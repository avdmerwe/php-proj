#!/bin/sh

set -e

#DEBHELPER#

case "$1" in
    configure)
        # Enable the extension for all PHP SAPIs
        if which phpenmod >/dev/null 2>&1; then
            phpenmod -v ALL -s ALL proj
        fi
        ;;
    abort-upgrade|abort-remove|abort-deconfigure)
        ;;
    *)
        echo "postinst called with unknown argument \`$1'" >&2
        exit 1
        ;;
esac

exit 0