.SH EXAMPLES
.SS Basic CRS Operations
.nf
.B <?php
.B declare(strict_types=1);
.B 
.B // Create CRS using various methods
.B $crs1 = ProjCRS::fromEpsg(4326);
.B $crs2 = ProjCRS::fromWkt($wkt_string);
.B $crs3 = ProjCRS::fromProj4('+proj=longlat +datum=WGS84 +no_defs +type=crs');
.B 
.B // Get CRS information
.B echo $crs1->getName();           // "WGS 84"
.B echo $crs1->getTypeName();       // "Geographic 2D CRS"
.B print_r($crs1->getAxisInfo());   // Array of axis information
.B echo $crs1->getToEpsg();         // 4326
.B ?>
.fi

.SS Coordinate Transformations
.nf
.B <?php
.B declare(strict_types=1);
.B 
.B // Create transformer
.B $transformer = ProjTransformer::fromCrs('EPSG:4326', 'EPSG:3857');
.B 
.B // Transform single point
.B [$x, $y] = $transformer->transform(-74.0, 40.7);
.B 
.B // Transform multiple points
.B $coordinates = [[-74.0, 40.7], [-73.9, 40.8]];
.B $result = $transformer->transformArray($coordinates);
.B 
.B // Transform bounding box
.B $bounds = $transformer->transformBounds(-180.0, -85.0, 180.0, 85.0);
.B ?>
.fi

.SS Geodetic Calculations
.nf
.B <?php
.B declare(strict_types=1);
.B 
.B // Create geodetic calculator using factory methods
.B $geod = ProjGeod::fromEpsg(4326);                           // WGS84 from EPSG
.B $geod = ProjGeod::fromCrs("EPSG:4269");                     // NAD83 from CRS string
.B $geod = ProjGeod::fromParameters(6378137.0, 0.0033528107);  // Auto-detect flattening
.B 
.B // Forward geodetic computation (bearing and distance to coordinates)
.B $result = $geod->fwd([[-74.0, 40.7]], 45.0, 10000.0);
.B [$lon2, $lat2, $back_azimuth] = $result[0];
.B 
.B // Inverse geodetic computation (coordinates to bearing and distance)
.B $result = $geod->inv([[-74.0, 40.7]], [[-73.9, 40.8]]);
.B [$forward_az, $back_az, $distance] = $result[0];
.B 
.B // Calculate polygon area and perimeter
.B $points = [[-74.0, 40.7], [-73.9, 40.8], [-73.8, 40.7], [-74.0, 40.7]];
.B $result = $geod->polygonAreaPerimeter($points);
.B echo "Area: {$result['area']} sq meters";
.B ?>
.fi

.SS Error Handling
.nf
.B <?php
.B declare(strict_types=1);
.B 
.B try {
.B     $crs = ProjCRS::fromEpsg(4326);
.B     $transformer = ProjTransformer::fromCrs($crs, 'EPSG:3857');
.B     [$x, $y] = $transformer->transform(-74.0, 40.7);
.B } catch (ProjCRSException $e) {
.B     echo "CRS Error: " . $e->getMessage();
.B } catch (ProjTransformerException $e) {
.B     echo "Transformer Error: " . $e->getMessage();
.B } catch (ProjException $e) {
.B     echo "General PROJ Error: " . $e->getMessage();
.B }
.B ?>
.fi

.SH CONFIGURATION
.SS PHP Configuration
Add the following line to your PHP configuration file (php.ini):
.nf
.B extension=proj.so
.fi

.SS Network Access
Enable network access for downloading transformation grids:
.nf
.B <?php
.B proj_set_network_enabled(true);
.B ?>
.fi

.SS Data Directory
Set custom data directory for PROJ grid files:
.nf
.B <?php
.B proj_set_user_data_dir('/path/to/proj/data');
.B ?>
.fi

