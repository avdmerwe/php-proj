#!/bin/sh

set -e

#DEBHELPER#

case "$1" in
    remove|deconfigure)
        # Disable the extension for all PHP SAPIs
        if which phpdismod >/dev/null 2>&1; then
            phpdismod -v ALL -s ALL proj
        fi
        ;;
    upgrade|failed-upgrade)
        ;;
    *)
        echo "prerm called with unknown argument \`$1'" >&2
        exit 1
        ;;
esac

exit 0